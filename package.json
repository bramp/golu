{
  "name": "golu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"public/*.js\" \"public/demo/**/*.json\" \".github/**/*.yml\" \"*.{js,json,md,ts}\" index.html studio.html .pre-commit-config.yaml",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"public/*.js\" \"public/demo/**/*.json\" \".github/**/*.yml\" \"*.{js,json,md,ts}\" index.html studio.html .pre-commit-config.yaml",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
